# Azure OpenAI (required for live runs)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment
# Optional: separate vision deployment (defaults to AZURE_OPENAI_DEPLOYMENT)
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Escape hatch: set to max_tokens or max_completion_tokens to skip detect-and-retry
AZURE_OPENAI_TOKEN_PARAM=
# Legacy fallback only
GPT4_LLM_MODEL_DEPLOYMENT_NAME=

# Local storage
UPLOAD_ROOT=data/uploads

# Optional integrations
ROBOFLOW_API_KEY=
# Roboflow model path: workspace/project/version (required with ROBOFLOW_API_KEY for YOLO detection)
ROBOFLOW_MODEL=
AZURE_STORAGE_CONNECTION_STRING=

# Set to 1 for orchestration-only runs without live Azure calls
DRY_RUN=0
